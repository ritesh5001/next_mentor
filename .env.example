# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored; never commit secrets.
# ---------------------------------------------------------------------------

# Neon Postgres. Console → your project → Connection string (pooled).
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — omit to disable the Google button).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Razorpay. Dashboard → Settings → API Keys (use TEST mode keys locally).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Settings → Webhooks. You choose this string when creating the
# webhook; it must match exactly or every webhook will be rejected as forged.
RAZORPAY_WEBHOOK_SECRET=""

# Cloudflare Stream. Dashboard → Stream. The account ID is in the URL.
CLOUDFLARE_ACCOUNT_ID=""
# API token with the "Stream:Edit" permission.
CLOUDFLARE_STREAM_TOKEN=""
# Stream → Settings → Signing keys → Create. Store the PEM base64-encoded so it
# survives being a single-line env var:
#   cat key.pem | base64 | tr -d '\n'
CLOUDFLARE_STREAM_SIGNING_KEY_ID=""
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=""
CLOUDFLARE_STREAM_WEBHOOK_SECRET=""

# Cloudflare R2. Dashboard → R2 → Manage API tokens.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="nextmentor-assets"
# Public bucket URL or your custom domain in front of it.
R2_PUBLIC_URL="https://assets.example.com"

# Resend. Dashboard → API Keys. The sending domain must be verified first,
# or every email silently fails.
RESEND_API_KEY=""
EMAIL_FROM="NextMentor <hello@yourdomain.com>"

# Public — inlined into the client bundle at build time. Nothing secret here.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
NEXT_PUBLIC_R2_PUBLIC_URL="https://assets.example.com"
