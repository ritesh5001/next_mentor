# ---------------------------------------------------------------------------
# Workspace .gitignore
#
# Patterns are deliberately NOT anchored with a leading slash. This is a pnpm
# monorepo (frontend/, backend/, shared/), and a root-anchored rule like
# "/.next/" only matches the repo root — which is why 897 build artifacts under
# frontend/.next/ ended up committed and Vercel started warning about them.
# ---------------------------------------------------------------------------

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
.next/
out/
build/
dist/

# testing
coverage/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never get committed...
.env
.env.*
# ...but the documented templates must be, or nobody can set the project up
# without asking which variables exist.
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling
.gstack/
