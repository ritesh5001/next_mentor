# ---------------------------------------------------------------------------
# Backend API (Render). Copy to .env and fill in.
#
# Note the filename: the backend reads .env, NOT .env.local. Both are
# gitignored; never commit real values.
#
# Secrets are validated per service (see src/lib/env.ts), so an unset
# Cloudflare key breaks video uploads only — it does not stop the API booting
# or take down checkout.
# ---------------------------------------------------------------------------

# --- core -------------------------------------------------------------------

# Postgres. Render → your database → Internal URL for the deployed API,
# External URL when running migrations from your machine.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Port the API listens on. Render sets this automatically; only matters locally.
PORT="4000"

# Signs the session JWTs. Generate with: openssl rand -base64 32
# Changing it logs everyone out. It is NOT needed by the frontend.
AUTH_SECRET=""

# --- CORS -------------------------------------------------------------------

# The frontend's public address. Used for links inside outgoing emails, so it
# must point at the website, never at this API.
WEB_ORIGIN="http://localhost:3000"

# Origins allowed to call this API, comma-separated. Defaults to WEB_ORIGIN.
# Must be the frontend's EXACT origin including scheme — a mismatch shows up as
# a CORS error in the browser and nothing at all in the server log.
CORS_ORIGINS="http://localhost:3000"

# --- scheduled work ---------------------------------------------------------

# Protects /api/cron/daily. Generate with: openssl rand -base64 32
# The endpoint fails closed without it. Left unset in production, commissions
# never mature, subscriptions never expire and badges are never awarded.
CRON_SECRET=""

# --- payments ---------------------------------------------------------------

# Razorpay → Settings → API Keys. Use TEST keys locally.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# You choose this value, then paste the same string into Razorpay →
# Settings → Webhooks. This webhook is what grants course access, so if it is
# wrong customers pay and receive nothing.
RAZORPAY_WEBHOOK_SECRET=""

# --- Cloudflare Stream (course video) ---------------------------------------

# In your dashboard URL: dash.cloudflare.com/<account-id>/...
CLOUDFLARE_ACCOUNT_ID=""

# Account API tokens → Create → "Start from scratch" → Account / Stream / Edit.
# Do NOT use the "Read all resources" or "Write all resources" templates: they
# are zone-scoped and cannot reach Stream at all.
CLOUDFLARE_STREAM_TOKEN=""

# Signing keys for private playback. There is NO dashboard page for these —
# create one with: ./scripts/get-stream-key.sh
# The `pem` Cloudflare returns is base64 of a PKCS#1 key
# ("-----BEGIN RSA PRIVATE KEY-----"). Paste it verbatim. The loader also
# accepts a raw PEM block if that is what you have, so either works.
CLOUDFLARE_STREAM_SIGNING_KEY_ID=""
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=""

# Stream → Settings → Webhooks. Tells us when a transcode finishes.
# Unset, the endpoint returns 503 by design and uploaded videos never become
# playable — it fails closed rather than letting anyone mark a lesson ready.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=""

# --- Cloudflare R2 (images, PDFs, certificates) -----------------------------

# Same value as CLOUDFLARE_ACCOUNT_ID.
R2_ACCOUNT_ID=""

# R2 → API → Manage API Tokens → Object Read & Write.
# These are S3-style credentials from R2's OWN token page — an Account API
# token will not authenticate against R2.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

R2_BUCKET=""

# Public base URL for the bucket: R2 → bucket → Settings → Custom Domains.
R2_PUBLIC_URL="https://assets.example.com"

# --- email ------------------------------------------------------------------

# resend.com → API Keys. The sending domain must be VERIFIED in Resend or
# delivery fails silently — nothing is thrown, the mail just never arrives.
RESEND_API_KEY=""
EMAIL_FROM="NextMentor <hello@yourdomain.com>"

# --- encryption -------------------------------------------------------------

# Encrypts KYC bank account numbers at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32   (must decode to exactly 32 bytes)
#
# PRODUCTION: move this to a managed KMS before collecting real bank details.
# An env var is only as protected as your deploy dashboard and every log line
# that might print process.env. getKey() in src/lib/crypto.ts is the one place
# to change.
KYC_ENCRYPTION_KEY=""
