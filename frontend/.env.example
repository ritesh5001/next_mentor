# ---------------------------------------------------------------------------
# Frontend (Vercel). Copy to .env.local and fill in.
#
# The frontend holds NO database credentials and NO service secrets. Everything
# sensitive lives in the backend. If you are about to add DATABASE_URL or an
# API secret here, it belongs in backend/.env instead.
#
# Blank is not the same as unset for the tooling, but it IS handled: every URL
# below goes through envUrl(), which treats "" and malformed values as absent
# and falls back to the localhost default (with a warning in the log).
# ---------------------------------------------------------------------------

# Where the Hono API lives.
#
# Two variables for one address, because they are read in different places:
#   API_URL             server-side (Server Components, Server Actions)
#   NEXT_PUBLIC_API_URL browser-side, and inlined at BUILD time
#
# Set BOTH. Missing NEXT_PUBLIC_API_URL is the classic failure: pages render
# fine on the server and every client-side call 404s.
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# This site's own public address. Used for canonical URLs, OpenGraph and the
# metadataBase. In production set it to the real domain, WITH the scheme —
# "yourdomain.com" without https:// is rejected and falls back to localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay PUBLIC key id (rzp_test_… or rzp_live_…). Safe to expose: it only
# opens the checkout modal. The secret key never leaves the backend.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"

# Public base URL for R2 assets (course thumbnails, avatars).
# Cloudflare → R2 → your bucket → Settings → Custom Domains.
# Whatever host you use must ALSO be listed in next.config.ts remotePatterns,
# or next/image refuses to optimise it.
NEXT_PUBLIC_R2_PUBLIC_URL="https://assets.example.com"

# ---------------------------------------------------------------------------
# NOT needed here, despite appearances:
#
#   AUTH_SECRET   The frontend decodes the JWT without verifying it (only to
#                 pick which nav to render). Every real authorisation decision
#                 happens in the API, which does verify the signature. Adding
#                 the signing secret here would spread it for no benefit.
# ---------------------------------------------------------------------------
